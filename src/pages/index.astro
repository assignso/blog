---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME } from "@consts";
import { getPublishedPosts } from "@lib/posts";

const posts = (await getPublishedPosts()).slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h1 class="animate text-2xl font-semibold text-black dark:text-white">
      Ideas for making progress
    </h1>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            Product updates, engineering notes, and practical lessons from the team building
            <Link href="https://assign.so" aria-label="Visit Assign" external>Assign</Link>.
          </p>
          <p class="animate">
            We write about how work moves, what we learn while making Assign, and the product
            decisions that are useful beyond our own codebase.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Latest posts
          </h2>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {posts.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

    </div>
  </Container>
</PageLayout>
