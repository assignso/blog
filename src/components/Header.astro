---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between">
      <Link href="/" underline={false} aria-label="Assign Blog home">
        <div class="flex items-center gap-2 font-semibold tracking-tight">
          <img
            src="/brand/assign-logo-rounded.svg"
            alt=""
            width="20"
            height="20"
            class="size-5"
          />
          {SITE.NAME}
        </div>
      </Link>
      <nav aria-label="Primary" class="flex gap-1">
        <Link href="https://assign.so" external aria-label="Visit assign.so">
          assign.so
        </Link>
        <span>
          {`/`}
        </span>
        <Link href="/blog">
          all posts
        </Link>
        <span>
          {`/`}
        </span>
        <Link href="/changelog">
          changelog
        </Link>
      </nav>
    </div>
  </Container>
</header>
